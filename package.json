{
  "name": "entilaaqa-react",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch --env-file-if-exists=.env server/src/server.js",
    "build": "vite build",
    "start": "node server/src/server.js",
    "install:server": "npm install --prefix server --omit=dev",
    "render-build": "npm install --include=dev && npm run install:server && npm run build"
  },
  "dependencies": {
    "gsap": "^3.12.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
